<style-scheme id="textmate-light" name="TextMate Light" version="1.0">
  <author>CherryTree</author>
  <_description>Clean light scheme in the spirit of TextMate's Mac Classic theme</_description>

  <color name="white"        value="#FFFFFF"/>
  <color name="black"        value="#000000"/>
  <color name="text-fg"      value="#1A1A1A"/>
  <color name="caret"        value="#000000"/>
  <color name="selection"    value="#B5D5FF"/>
  <color name="line-hl"      value="#EEF5FF"/>
  <color name="gutter-bg"    value="#F7F7F7"/>
  <color name="gutter-fg"    value="#9E9E9E"/>
  <color name="margin"       value="#E6E6E6"/>
  <color name="spaces"       value="#D0D0D0"/>
  <color name="comment"      value="#0066FF"/>
  <color name="keyword"      value="#0000FF"/>
  <color name="string"       value="#036A07"/>
  <color name="number"       value="#0000CD"/>
  <color name="constant"     value="#C5060B"/>
  <color name="function"     value="#0000A2"/>
  <color name="type"         value="#6E3C03"/>
  <color name="variable"     value="#318495"/>
  <color name="support"      value="#3C4C72"/>
  <color name="preprocessor" value="#1C02FF"/>
  <color name="search"       value="#FFF0A0"/>
  <color name="error"        value="#FF0000"/>
  <color name="warning"      value="#C77800"/>

  <!-- Global Settings -->
  <style name="text"                        foreground="text-fg" background="white"/>
  <style name="cursor"                      foreground="caret"/>
  <style name="selection"                   background="selection"/>
  <style name="current-line"                background="line-hl"/>
  <style name="current-line-number"         background="line-hl" foreground="#555555"/>
  <style name="line-numbers"                foreground="gutter-fg" background="gutter-bg"/>
  <style name="right-margin"                foreground="margin" background="margin"/>
  <style name="bracket-match"               background="#DDEEFF" bold="true"/>
  <style name="bracket-mismatch"            background="#FFD0D0"/>
  <style name="draw-spaces"                 foreground="spaces"/>
  <style name="background-pattern"          background="#FAFAFA"/>
  <style name="search-match"                background="search"/>
  <style name="bookmark"                    background="#E5E5FF"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="comment" italic="true"/>
  <style name="def:shebang"                 foreground="comment" bold="true"/>
  <style name="def:doc-comment"             foreground="comment" italic="true"/>
  <style name="def:doc-comment-element"     foreground="comment" bold="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="constant"/>
  <style name="def:decimal"                 foreground="number"/>
  <style name="def:base-n-integer"          foreground="number"/>
  <style name="def:floating-point"          foreground="number"/>
  <style name="def:complex"                 use-style="def:base-n-integer"/>
  <style name="def:character"               foreground="string"/>
  <style name="def:string"                  foreground="string"/>
  <style name="def:special-char"            foreground="constant"/>
  <style name="def:boolean"                 foreground="constant"/>
  <style name="def:special-constant"        foreground="constant"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="variable"/>
  <style name="def:function"                foreground="function" bold="true"/>
  <style name="def:builtin"                 foreground="support" bold="true"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="keyword" bold="true"/>
  <style name="def:keyword"                 foreground="keyword" bold="true"/>
  <style name="def:operator"                foreground="black"/>

  <!-- Types -->
  <style name="def:type"                    foreground="type" bold="true"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         bold="true"/>
  <style name="def:inline-code"             foreground="function"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="comment"/>
  <style name="def:link-symbol"             foreground="comment" bold="true"/>
  <style name="def:link-destination"        underline="single" foreground="keyword"/>
  <style name="def:heading"                 foreground="function" bold="true"/>
  <style name="def:thematic-break"          foreground="gutter-fg"/>
  <style name="def:preformatted-section"    foreground="function"/>
  <style name="def:list-marker"             foreground="keyword" bold="true"/>
  <style name="def:underlined"              underline="single"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="preprocessor"/>
  <style name="def:note"                    foreground="#BF0303" background="#F7E7E7" bold="true"/>
  <style name="def:error"                   foreground="error" underline="true"/>
  <style name="def:warning"                 foreground="warning" underline="true"/>
  <style name="def:net-address"             foreground="keyword" underline="single"/>

  <!-- Language specific styles -->
  <style name="c:preprocessor"              foreground="preprocessor"/>
  <style name="c:included-file"             foreground="string"/>
  <style name="diff:added-line"             foreground="string"/>
  <style name="diff:removed-line"           foreground="constant"/>
  <style name="diff:changed-line"           foreground="preprocessor"/>
  <style name="diff:location"               foreground="type"/>
  <style name="diff:diff-file"              bold="true"/>
  <style name="xml:attribute-name"          foreground="variable"/>
  <style name="xml:element-name"            foreground="keyword" bold="true"/>
  <style name="xml:entity"                  foreground="constant"/>
  <style name="xml:processing-instruction"  bold="true"/>
  <style name="xml:doctype"                 foreground="type" bold="true"/>
  <style name="js:built-in-constructor"     foreground="support" bold="true"/>
  <style name="python:builtin-function"     foreground="support"/>
  <style name="python:builtin-constant"     foreground="constant"/>
  <style name="python:builtin-object"       foreground="support"/>
  <style name="sh:dollar"                   foreground="variable" bold="true"/>
  <style name="makefile:trailing-tab"       background="#FFC0CB"/>
</style-scheme>
